# Copie para .env:  cp .env.example .env
# NUNCA comite o .env.
# Use senhas sem @ : / ? # (elas entram numa URL de conexão do Postgres).

POSTGRES_USER=mininoc
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=mininoc

GRAFANA_PASSWORD=troque_esta_senha

# Integrações opcionais. Vazio = o bot grava o ticket apenas localmente.
# Discord: Configurações do canal > Integrações > Webhooks > Copiar URL
DISCORD_WEBHOOK_URL=

# GitHub: fine-grained token com permissão "Issues: read/write" no repo do projeto
GITHUB_TOKEN=
GITHUB_REPO=JeipiDeveloper/mini-noc
